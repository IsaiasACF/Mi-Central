APP_NAME=Mi Central
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Santiago

DB_HOST=db
DB_PORT=3306
DB_DATABASE=mi_central
DB_USERNAME=mi_central
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=mi_central_session
SESSION_SECURE=false
SESSION_IDLE_TIMEOUT=7200

FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
WHISPER_BIN=/usr/local/bin/whisper-cli
WHISPER_MODELS_PATH=/var/www/html/storage/models/whisper
WHISPER_MODEL_PATH=/var/www/html/storage/models/whisper/ggml-base.bin
VIDEO_MAX_UPLOAD_MB=1024
