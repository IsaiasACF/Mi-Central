APP_NAME=Mi Central
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/Santiago
WEB_PORT=8080

DB_HOST=db
DB_PORT=3306
DB_DATABASE=mi_central
DB_USERNAME=mi_central
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
DB_CHARSET=utf8mb4
DB_EMULATE_PREPARES=false
DB_SSL_ENABLED=false
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_VERIFY_SERVER_CERT=true

SESSION_NAME=mi_central_session
SESSION_DRIVER=file
SESSION_TABLE=sessions
SESSION_TTL=7200
SESSION_SECURE=false
SESSION_IDLE_TIMEOUT=7200

COLLECTOR_HTTP_TIMEOUT=15
COLLECTOR_HTTP_CONNECT_TIMEOUT=5
COLLECTOR_HTTP_MAX_REDIRECTS=3
COLLECTOR_USER_AGENT=MiCentral-DiscountCollector/1.0
COLLECTOR_MAX_RESPONSE_BYTES=1048576
COLLECTOR_DEFAULT_INTERVAL_MINUTES=1440
COLLECTOR_MIN_INTERVAL_MINUTES=60
COLLECTOR_RETRY_MINUTES=60
COLLECTOR_STALE_AFTER_MINUTES=180
COLLECTOR_BANCO_CHILE_MAX_ITEMS=0
COLLECTOR_BANCO_CHILE_REQUEST_DELAY_MS=500
COLLECTOR_SANTANDER_MAX_ITEMS=0
COLLECTOR_SANTANDER_REQUEST_DELAY_MS=500
COLLECTOR_BANCOESTADO_MAX_ITEMS=0
COLLECTOR_BANCOESTADO_REQUEST_DELAY_MS=500

FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
VIDEO_MAX_UPLOAD_MB=1024
VIDEO_EXPORT_RETENTION_DAYS=30
